{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tx",
    "recipient",
    "minimum_raw",
    "token",
    "confirmations",
    "finalized"
  ],
  "properties": {
    "tx": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "recipient": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "minimum_raw": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,77}$"
    },
    "token": {
      "type": "string",
      "enum": [
        "ZTO",
        "IMD"
      ]
    },
    "confirmations": {
      "type": "integer",
      "minimum": 13,
      "maximum": 1000000
    },
    "finalized": {
      "type": "boolean"
    }
  }
}
